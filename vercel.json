{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.5.1"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    }
  ]
}
