{
  "name": "rpr-cis-scan-v2",
  "version": "2.0.0",
  "description": "RPR CIS SCAN v2 - Hybrid Individual KYC + Business Entity Verification platform for Australian business entities",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx -r dotenv/config scripts/migrate.js",
